# Server
PORT=5000
NODE_ENV=development
# Exact URL of the frontend (used for CORS and the password-reset link)
CLIENT_URL=http://localhost:5173
# Timezone used to group analytics by month
APP_TIMEZONE=Asia/Kolkata

# Database and auth
MONGO_URI=
JWT_SECRET=

# Cloudinary (avatars and receipt images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini (receipt scanning)
GEMINI_API_KEY=
# Optional: pin a specific model instead of the moving "latest" alias
GEMINI_MODEL=

# Gmail account (use an app password) for password-reset emails
EMAIL_USER=
EMAIL_PASS=
